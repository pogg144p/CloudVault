# Project Environment Configuration
PROJECT_NAME="CloudVault"
ENVIRONMENT="development"
SECRET_KEY="cloudvault-super-secure-dev-secret-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Defaults to local SQLite for quick out-of-the-box development, switch to PostgreSQL when ready:
# DATABASE_URL="postgresql+asyncpg://cloudvault:cloudvault@localhost:5432/cloudvault_db"
DATABASE_URL="sqlite+aiosqlite:///./cloudvault.db"

# Storage Configuration
# local | s3
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="./storage_data"

# S3 / MinIO Configuration (for Phase 2 / production)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="cloudvault-bucket"
S3_REGION="us-east-1"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Default User Storage Quota (10 GB in bytes)
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
