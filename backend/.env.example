# ==========================================
# CloudVault Configuration Environment
# ==========================================

# Active Storage Driver: 'local' or 's3'
STORAGE_BACKEND=local

# Local Storage Directory (used when STORAGE_BACKEND=local)
LOCAL_STORAGE_DIR=./storage_data

# ==========================================
# Cloud S3-Compatible Storage Settings (Supabase / AWS / Cloudflare)
# ==========================================
# When ready to test Supabase, change STORAGE_BACKEND=s3 above and paste your Supabase S3 credentials below:
S3_ENDPOINT_URL=https://<PROJECT_REF>.supabase.co/storage/v1/s3
S3_ACCESS_KEY=<YOUR_SUPABASE_ACCESS_KEY_ID>
S3_SECRET_KEY=<YOUR_SUPABASE_SECRET_ACCESS_KEY>
S3_BUCKET_NAME=cloudvault-bucket
S3_REGION=us-east-1
S3_SECURE=true

# Database (SQLite local, PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./cloudvault.db

# Security & Sessions
SECRET_KEY=cloudvault-super-secure-dev-secret-key-change-in-prod-xyz123
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Storage Quota: 10 GB
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
